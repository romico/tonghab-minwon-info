{
  "name": "tonghab-minwon-info",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "release:win": "node scripts/build-release.mjs --platform win32-x64",
    "release:linux": "node scripts/build-release.mjs --platform linux-x64",
    "release:mac": "node scripts/build-release.mjs --platform darwin-arm64",
    "release:mac-intel": "node scripts/build-release.mjs --platform darwin-x64",
    "release:all": "node scripts/build-release.mjs --all",
    "deploy:update-feed": "node scripts/deploy-update-feed.mjs",
    "deploy:landing": "npx wrangler pages deploy landing --project-name tonghab-minwon --commit-dirty=true",
    "seed:year": "node scripts/seed-year.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
